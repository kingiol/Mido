{
  "name": "@mido-agent/toolkit-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "require": "./dist/memory.cjs"
    },
    "./search-retrieval": {
      "types": "./dist/search-retrieval.d.ts",
      "import": "./dist/search-retrieval.js",
      "require": "./dist/search-retrieval.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "require": "./dist/workspace.cjs"
    }
  },
  "dependencies": {
    "@mido-agent/protocol-core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/memory.ts src/search-retrieval.ts src/workspace.ts --format esm,cjs --dts"
  }
}
